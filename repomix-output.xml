.closingHeader h2 {
  font-family: var(--font-display), var(--font-bengali), sans-serif;
  font-size: clamp(1.7rem, 3vw, 2.3rem);
  line-height: 1.1;
  letter-spacing: -0.5px;
  color: var(--ink-900);
  margin-top: 6px;
}

.closingMore {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--teal-700);
  text-decoration: none;
}

.closingMore:hover {
  text-decoration: underline;
}

.liveDot {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #e63946;
  box-shadow: 0 0 0 0 rgba(230, 57, 70, 0.6);
  animation: livePulse 1.4s ease-in-out infinite;
}

.closingGrid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

/* Card: no top padding — thumbnail bleeds to the edges */
.closingCard {
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border: 1px solid var(--sand-200);
  border-radius: var(--radius-lg);
  text-decoration: none;
  color: inherit;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(15, 34, 52, 0.06);
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}

.closingCard:hover {
  transform: translateY(-4px);
  border-color: var(--teal-400, #2ab5b3);
  box-shadow: 0 16px 36px rgba(15, 143, 141, 0.18);
}

/* ── Thumbnail zone ── */
.closingThumb {
  position: relative;
  height: 148px;
  overflow: hidden;
  flex-shrink: 0;
}

.closingThumbImg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}

.closingCard:hover .closingThumbImg {
  transform: scale(1.04);
}

/* Gradient fallback when no thumbnail */
.closingThumbFallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.closingThumbInitials {
  font-family: var(--font-display), sans-serif;
  font-size: 32px;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.22);
  letter-spacing: 2px;
  user-select: none;
}

/* Bottom gradient so badge is always legible over any image */
.closingThumbOverlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    transparent 40%,
    rgba(10, 20, 30, 0.72) 100%
  );
}

/* Badge: overlaid on the thumbnail bottom-left */
.closingBadge {
  position: absolute;
  bottom: 10px;
  left: 12px;
  padding: 3px 10px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.15);
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.3);
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}

/* ── Card body (below thumbnail) ── */
.closingCardBody {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 14px 16px 12px;
  flex: 1;
}

.closingCardBody h3 {
  font-size: 14px;
  line-height: 1.35;
  color: var(--ink-900);
  font-weight: 700;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.closingMeta {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 11.5px;
  color: var(--ink-500);
  margin: 0;
  flex-wrap: wrap;
}

/* ── Urgency strip at the very bottom of the card ── */
.closingUrgencyBar {
  height: 3px;
  flex-shrink: 0;
  opacity: 0.85;
  transition: opacity 0.2s ease;
}

.closingCard:hover .closingUrgencyBar {
  opacity: 1;
}

.closingEmpty {
  padding: 28px;
  background: #ffffff;
  border: 1px dashed var(--sand-200);
  border-radius: 16px;
  font-size: 14px;
  color: var(--ink-500);
  text-align: center;
}

.closingEmpty a {
  color: var(--teal-700);
  font-weight: 600;
  text-decoration: none;
}

.closingEmpty a:hover {
  text-decoration: underline;
}

/* ── Responsive ── */
@media (max-width: 1100px) {
  .closingGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 980px) {
  .hero,
  .mentorShowcase {
    grid-template-columns: 1fr;
    gap: 48px;
  }

  .mentorMockAnnotation[data-position="top-right"] {
    top: -92px;
    right: 0;
  }

  .mentorMockAnnotation[data-position="bottom-left"] {
    bottom: -92px;
    left: 0;
  }
}

@media (max-width: 820px) {
  /* On mobile: input pill on top, full-width button below */
  .searchForm {
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    padding: 0;
    background: transparent;
    border: none;
    box-shadow: none;
  }

  .searchForm:focus-within {
    box-shadow: none;
    border-color: transparent;
  }

  /* Input gets its own pill */
  .searchInputWrap {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #ffffff;
    border: 1.5px solid var(--sand-200);
    border-radius: 999px;
    padding: 12px 18px;
    box-shadow: 0 4px 20px rgba(15, 143, 141, 0.1);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .searchForm:focus-within .searchInputWrap {
    border-color: var(--teal-500);
    box-shadow: 0 6px 24px rgba(15, 143, 141, 0.18);
  }

  .searchIcon {
    margin-right: 0;
    flex-shrink: 0;
    color: var(--ink-500);
  }

  .searchInput {
    font-size: 16px; /* 16px prevents iOS zoom on focus */
    padding: 0;
    background: transparent;
  }

  /* Full-width teal button below the input */
  .searchButton {
    width: 100%;
    padding: 14px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.2px;
    box-shadow: 0 8px 24px rgba(15, 143, 141, 0.28);
  }

  .workflowRow {
    border-radius: 24px;
    padding: 20px;
    gap: 12px;
  }

  .workflowArrow {
    transform: rotate(90deg);
  }
}

@media (max-width: 720px) {
  .page {
    padding: 16px 5vw 56px;
    gap: 28px;
  }

  /* Hero text tighter on small screens */
  .heroLeft h1 {
    font-size: clamp(1.45rem, 6.2vw, 1.95rem);
    letter-spacing: -0.4px;
    line-height: 1.1;
    margin: 4px 0 6px;
  }

  /* Mobile: drop the kicker — it's marketing fluff that costs vertical space
     on a viewport that needs to fit the search above the fold. */
  .heroLeft .kicker {
    display: none;
  }

  /* Tighter description on mobile, capped to 2 lines */
  .lede {
    font-size: 14px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Hide the secondary "Talk to AI Mentor" link — the bottom tab bar
     and Browse CTA already give them clear primary actions. */
  .heroAlternative {
    display: none;
  }

  /* Hide the in-hero product preview on small phones — it crowds and the
     real product is one tap away via the Mentor tab. */
  .previewWrap {
    display: none;
  }

  /* Stats: 2-column with the third (24/7 fluff) hidden — even count fits cleanly */
  .stats {
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    padding-top: 14px;
    margin-top: 14px;
  }

  .statTertiary {
    display: none;
  }

  .statValue {
    font-size: 18px;
  }

  /* Search: slightly smaller padding on very small phones */
  .searchForm {
    gap: 8px;
  }

  .searchInputWrap {
    padding: 11px 16px;
  }

  .searchInput {
    font-size: 16px;
  }

  .searchButton {
    padding: 13px;
    font-size: 14px;
  }

  /* Browse-all CTA: full width, clean alignment */
  .heroBrowseRow {
    width: 100%;
  }

  .browseAllCta {
    width: 100%;
    justify-content: flex-start;
    gap: 10px;
    padding: 10px 14px 10px 16px;
  }

  .browseAllLabel {
    font-size: 13px;
    flex: 1;
  }

  .browseAllCount {
    font-size: 11px;
    padding: 2px 7px;
  }

  /* Popular tags: tighter so all 4 fit on two lines cleanly */
  .quickTags {
    gap: 6px;
    margin-top: 10px;
  }

  .quickTags a {
    font-size: 12px;
    padding: 5px 10px;
  }

  /* Hide the 4th tag and beyond on mobile — keeps the row clean */
  .quickTags a:nth-child(n+5) {
    display: none;
  }

  /* Workflow: collapse to a single thin row, no wrapping arrows */
  .workflowRow {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px 12px;
    padding: 14px 16px;
    border-radius: 16px;
    font-size: 12.5px;
  }

  .workflowItem {
    gap: 6px;
  }

  .workflowItem strong + span {
    display: none;  /* hide the descriptive text — keep just numbers + verbs */
  }

  .workflowDot {
    width: 20px;
    height: 20px;
    font-size: 10.5px;
  }

  .workflowArrow {
    transform: none;
    font-size: 13px;
  }

  /* Closing soon: single-column stack of cards on mobile */
  .closingGrid {
    grid-template-columns: 1fr;
  }

  /* Mobile section order: hero → closing-soon → workflow */
  .hero { order: 1; }
  .closingSection { order: 2; }
  .workflowRow { order: 3; }

  .mentorShowcase {
    display: none;
  }

  .guideTeaser {
    order: 5;
  }
}

/* ── Guide Teaser Section (homepage) ── */
.guideTeaser {
  display: flex;
  flex-direction: column;
  gap: 28px;
  padding: 48px 40px;
  background: linear-gradient(135deg, #0f2633 0%, #0a4a48 60%, #0f8f8d 100%);
  border-radius: 28px;
  position: relative;
  overflow: hidden;
}

.guideTeaser::before {
  content: "";
  position: absolute;
  top: -80px;
  right: -80px;
  width: 320px;
  height: 320px;
  background: radial-gradient(circle, rgba(93, 232, 222, 0.12), transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.guideTeaserHeader {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}

.guideTeaserHeader .kicker {
  color: #5de8de;
}

.guideTeaserHeader h2 {
  font-family: var(--font-display), var(--font-bengali), sans-serif;
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: #fff;
  margin-top: 6px;
}

.guideTeaserHeader .sectionSubtext {
  color: rgba(255, 255, 255, 0.75);
  max-width: 460px;
}

.guideTeaserSeeAll {
  display: inline-block;
  white-space: nowrap;
  font-size: 14px;
  font-weight: 600;
  color: #5de8de;
  border: 1px solid rgba(93, 232, 222, 0.4);
  padding: 8px 18px;
  border-radius: 100px;
  transition: background 0.2s, color 0.2s;
  flex-shrink: 0;
}

.guideTeaserSeeAll:hover {
  background: rgba(93, 232, 222, 0.12);
  color: #fff;
}

.guideTeaserGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.guideTeaserCard {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 20px;
  background: rgba(255, 255, 255, 0.07);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 16px;
  text-decoration: none;
  color: #fff;
  backdrop-filter: blur(6px);
  transition: background 0.2s, border-color 0.2s, transform 0.2s;
  cursor: pointer;
}

.guideTeaserCard:hover {
  background: rgba(255, 255, 255, 0.13);
  border-color: rgba(93, 232, 222, 0.4);
  transform: translateY(-2px);
}

.guideTeaserCategory {
  font-size: 10.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: #5de8de;
}

.guideTeaserTitle {
  font-size: 15px;
  font-weight: 700;
  line-height: 1.4;
  color: #fff;
  margin: 0;
}

.guideTeaserExcerpt {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.65);
  line-height: 1.55;
  flex: 1;
}

.guideTeaserCount {
  font-size: 12px;
  font-weight: 600;
  color: #5de8de;
  margin-top: 4px;
}

@media (max-width: 720px) {
  .guideTeaser {
    padding: 28px 20px;
    border-radius: 20px;
  }

  .guideTeaserGrid {
    grid-template-columns: 1fr;
  }

  .guideTeaserHeader {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
}
