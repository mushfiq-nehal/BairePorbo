  padding: 0.1em 0.35em;
}

/* Code blocks */
.markdownBody pre {
  background: #0f1e2e;
  border-radius: 10px;
  padding: 12px 14px;
  overflow-x: auto;
  margin: 0.6em 0;
}

.markdownBody pre code {
