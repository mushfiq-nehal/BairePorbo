/* ─────────────────────────────────────────────────────────────
   CV Analyzer page
   ───────────────────────────────────────────────────────────── */

.page {
  position: relative;
  min-height: 100vh;
  background: var(--bg-body);
  padding: 16px 8vw 80px;
  /* overflow-x: hidden (not clip) forces overflow-y to compute as "auto"
     per spec, turning .page into a real scroll container. The ::before/
     ::after blobs below poke outside the box via negative offsets, so
     that "auto" overflow becomes genuine content — giving .page its own
     internal scrollbar alongside the document's, i.e. a double scrollbar.
     clip avoids both problems. */
  overflow: clip;
}

.page::before,
.page::after {
  content: "";
  position: absolute;
  width: 520px;
  height: 520px;
  border-radius: 50%;
  z-index: 0;
  pointer-events: none;
  filter: blur(8px);
}
.page::before {
  top: -200px;
  left: -180px;
  background: radial-gradient(circle, rgba(240, 138, 104, 0.32), transparent 70%);
}
.page::after {
  bottom: -260px;
  right: -160px;
  background: radial-gradient(circle, rgba(15, 143, 141, 0.28), transparent 70%);
}

.main {
  position: relative;
  z-index: 1;
  max-width: 960px;
  margin: 0 auto;
  padding: 24px 0 32px;
  display: flex;
  flex-direction: column;
  gap: 26px;
}

.back {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--teal-700);
  text-decoration: none;
  font-weight: 600;
  font-size: 14px;
  padding: 6px 12px 6px 8px;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid var(--border-default);
  transition: background 0.15s ease, border-color 0.15s ease;
}
.back:hover {
  background: var(--teal-100);
  border-color: var(--teal-200);
}

/* ── Hero ───────────────────────────────────────────────── */
.hero {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
  align-items: center;
  gap: 28px;
  padding: 40px 38px 36px;
  border-radius: 26px;
  background:
    radial-gradient(
      900px 360px at 0% 0%,
      rgba(240, 138, 104, 0.22),
      transparent 70%
    ),
    radial-gradient(
      900px 360px at 100% 100%,
      rgba(15, 143, 141, 0.2),
      transparent 70%
