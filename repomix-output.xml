                  {[p.country, p.deadline].filter(Boolean).join(" · ")}
                </Txt>
              </View>
            </View>
            <Ionicons name="chevron-forward" size={18} color={colors.ink300} />
          </Pressable>
        ))}

        {/* Mentor teaser */}
        <Pressable
          onPress={() => router.push("/chat")}
          className="mt-3.5 rounded-[20px] p-[18px] overflow-hidden"
