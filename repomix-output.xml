<file path="apps/web/src/app/guide/[slug]/guide-detail.module.css">
.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 32px 8vw 64px;
}

.main {
  flex: 1;
  max-width: 1200px;
  width: 100%;
  margin: 0 auto;
  padding: 2rem 0 4rem;
}

/* ── Breadcrumb ── */
.breadcrumb {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.8125rem;
  color: var(--ink-500);
  margin-bottom: 2rem;
  flex-wrap: wrap;
}

.breadcrumb a {
  color: var(--teal-500);
  transition: color 0.15s;
}

.breadcrumb a:hover {
  color: var(--teal-700);
}

/* ── Layout: article + sidebar ── */
.layout {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 3rem;
  align-items: start;
}

/* ── Article ── */
.article {
  min-width: 0;
}

.articleHeader {
  margin-bottom: 2.5rem;
}

.headerMeta {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1rem;
}

.categoryBadge {
  font-size: 0.725rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  padding: 0.25rem 0.65rem;
  border-radius: 100px;
  background: #e0f5f4;
  color: #0a6d6b;
}

.updateDate {
  font-size: 0.8rem;
  color: var(--ink-500);
}

/* ── Author byline ── */
.authorByline {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.5rem 0.75rem;
  margin-top: 1rem;
  padding: 0.75rem 1rem;
  background: var(--sand-50, #faf9f7);
  border: 1px solid var(--sand-200, #e8e3db);
  border-radius: 10px;
  font-size: 0.8125rem;
}

.authorName {
  font-weight: 700;
  color: var(--ink-900);
}

.authorDesig {
  color: var(--ink-500);
}

.authorDesig::before {
  content: "·";
  margin-right: 0.5rem;
  color: var(--ink-300);
}

.authorDate {
  color: var(--ink-400);
  margin-left: auto;
  font-size: 0.775rem;
}

.articleTitle {
  font-family: var(--font-display), var(--font-bengali), sans-serif;
  font-size: clamp(1.6rem, 4vw, 2.25rem);
  font-weight: 700;
  line-height: 1.2;
  color: var(--ink-900);
  margin-bottom: 1.25rem;
}

.articleIntro {
  font-size: 1.0625rem;
  color: var(--ink-700);
  line-height: 1.75;
  margin-bottom: 1.25rem;
  padding: 1rem;
  background: rgba(15, 143, 141, 0.04);
  border: 1px solid rgba(15, 143, 141, 0.12);
  border-radius: var(--radius-md);
}

.tagList {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.tag {
  font-size: 0.7rem;
  background: var(--sand-100);
  color: var(--ink-500);
  padding: 0.2rem 0.6rem;
  border-radius: 100px;
