<file path="apps/web/src/app/scholarships/scholarships.module.css">
.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  gap: 32px;
  padding: 16px 8vw 64px;
}

.main {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

/* ── Hero ── */
.hero {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
  gap: 24px;
  align-items: center;
}

.kicker {
  text-transform: uppercase;
  letter-spacing: 2px;
  font-size: 11px;
  color: var(--teal-700);
  font-weight: 600;
}

.hero h1 {
  font-family: var(--font-display), var(--font-bengali), sans-serif;
  font-size: clamp(1.95rem, 3.4vw, 2.7rem);
  line-height: 1.1;
  margin: 12px 0 10px;
}

.heroTitleFull {
  display: inline;
}

.heroTitleShort {
  display: none;
}

.subtitle {
  color: var(--ink-700);
  max-width: 520px;
}

.heroPanel {
  position: relative;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.96) 0%, rgba(247, 243, 238, 0.92) 100%);
  border: 1px solid rgba(15, 143, 141, 0.18);
  border-radius: 22px;
  padding: 20px 22px;
  box-shadow:
    0 10px 40px -12px rgba(15, 143, 141, 0.22),
    0 2px 8px rgba(15, 34, 52, 0.05);
  overflow: hidden;
  isolation: isolate;
  animation: heroPanelBreathe 4.5s ease-in-out infinite;
  transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.35s ease;
}

.heroPanel::before {
  content: "";
  position: absolute;
  inset: -2px;
  background:
    radial-gradient(circle at 20% 0%, rgba(15, 143, 141, 0.18), transparent 50%),
    radial-gradient(circle at 100% 100%, rgba(240, 138, 104, 0.14), transparent 55%);
  z-index: -1;
  opacity: 0.9;
}

.heroPanel::after {
  content: "";
  position: absolute;
  top: 0;
  left: -60%;
  width: 50%;
  height: 100%;
  background: linear-gradient(
    115deg,
    transparent 30%,
    rgba(255, 255, 255, 0.55) 50%,
    transparent 70%
  );
  transform: skewX(-20deg);
  animation: heroShine 6s ease-in-out infinite;
  pointer-events: none;
  z-index: 0;
}

.heroPanel:hover {
  transform: translateY(-3px);
  box-shadow:
    0 18px 50px -10px rgba(15, 143, 141, 0.32),
    0 4px 14px rgba(15, 34, 52, 0.08);
}

.heroPanel > * {
  position: relative;
  z-index: 1;
}

@keyframes heroPanelBreathe {
  0%, 100% {
    box-shadow:
      0 10px 40px -12px rgba(15, 143, 141, 0.22),
      0 2px 8px rgba(15, 34, 52, 0.05);
  }
  50% {
    box-shadow:
      0 14px 46px -10px rgba(15, 143, 141, 0.32),
      0 2px 8px rgba(15, 34, 52, 0.05);
  }
}

@keyframes heroShine {
  0%, 92% { left: -60%; }
  100% { left: 130%; }
}

.snapshotHeader {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
}

.heroPanel h3 {
  font-size: 15px;
  margin: 0;
  color: var(--ink-700);
  font-weight: 600;
  letter-spacing: 0.2px;
}

.liveBadge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 3px 9px 3px 8px;
  background: linear-gradient(135deg, #ff5a5f 0%, #e63946 100%);
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.2px;
  border-radius: 999px;
  text-transform: uppercase;
  box-shadow: 0 4px 14px rgba(230, 57, 70, 0.35);
}

.liveDot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.8);
  animation: liveDotPulse 1.6s ease-in-out infinite;
}

@keyframes liveDotPulse {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.85);
    transform: scale(1);
  }
  50% {
    box-shadow: 0 0 0 6px rgba(255, 255, 255, 0);
    transform: scale(1.15);
  }
}

.snapshotLine {
  font-weight: 600;
  color: var(--ink-900);
  margin: 0;
}

.snapshotCount {
  display: flex;
  align-items: center;
  gap: 14px;
  margin: 4px 0 12px;
}

.countNumber {
  font-family: var(--font-display), var(--font-bengali), sans-serif;
  font-size: clamp(2.6rem, 4.4vw, 3.4rem);
  font-weight: 700;
  line-height: 1;
  color: var(--teal-700);
  letter-spacing: -1px;
  animation: countPop 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.4);
}

.countLabel {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 2px;
  font-size: 13px;
  line-height: 1.25;
  color: var(--ink-700);
  font-weight: 500;
}

.countLabel em {
  font-style: normal;
  font-weight: 700;
  color: var(--ink-900);
}

@keyframes countPop {
  0% { transform: scale(0.85); opacity: 0; }
  60% { transform: scale(1.05); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

.urgencyLine {
  display: flex;
  align-items: center;
  gap: 6px;
  margin: 12px 0 0;
  padding: 7px 11px;
  background: rgba(240, 138, 104, 0.1);
  border: 1px solid rgba(240, 138, 104, 0.25);
  border-radius: var(--radius-sm);
  font-size: 12.5px;
  font-weight: 600;
  color: var(--coral-700);
}

.urgencyPulse {
  display: inline-block;
  animation: urgencyWiggle 1.4s ease-in-out infinite;
  font-size: 14px;
}

@keyframes urgencyWiggle {
  0%, 100% { transform: rotate(0) scale(1); }
  25% { transform: rotate(-12deg) scale(1.15); }
  75% { transform: rotate(12deg) scale(1.15); }
}

.snapshotProgress {
  position: relative;
  height: 4px;
  width: 100%;
  background: rgba(15, 143, 141, 0.1);
  border-radius: 999px;
  overflow: hidden;
}

.snapshotProgressFill {
  position: absolute;
  inset: 0;
  width: 40%;
  background: linear-gradient(90deg, transparent, var(--teal-500), var(--coral-400), transparent);
  border-radius: inherit;
  animation: progressSweep 2.4s ease-in-out infinite;
}

@keyframes progressSweep {
  0% { transform: translateX(-120%); }
  100% { transform: translateX(320%); }
}

.shimmerBar {
  display: block;
  height: 18px;
  width: 70%;
  border-radius: 6px;
  background: linear-gradient(
    90deg,
    rgba(15, 143, 141, 0.08) 0%,
    rgba(15, 143, 141, 0.18) 50%,
    rgba(15, 143, 141, 0.08) 100%
  );
  background-size: 200% 100%;
  animation: shimmerSlide 1.4s linear infinite;
}

@keyframes shimmerSlide {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.srOnly {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

@media (prefers-reduced-motion: reduce) {
  .heroPanel,
  .heroPanel::after,
  .liveDot,
  .countNumber,
  .urgencyPulse,
  .snapshotProgressFill,
  .shimmerBar {
    animation: none !important;
  }
}

/* ── Compact filter bar ── */
.filterBar {
  display: flex;
  align-items: center;
  gap: 4px;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid var(--sand-200);
  border-radius: 16px;
  padding: 6px 8px;
  box-shadow: 0 4px 24px rgba(15, 34, 52, 0.07);
  flex-wrap: wrap;
  transition: box-shadow 0.2s ease, border-color 0.2s ease;
}

.filterBar:focus-within {
  border-color: var(--teal-500);
  box-shadow: 0 4px 24px rgba(15, 143, 141, 0.18);
}

/* Search */
.searchWrap {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1 1 200px;
  min-width: 160px;
  padding: 4px 8px;
  position: relative;
}

.searchIcon {
  color: var(--ink-500);
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.searchInput {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  font-size: 14px;
  font-family: inherit;
  color: var(--ink-900);
  min-width: 0;
}

.searchInput:focus,
.searchInput:focus-visible {
  outline: none;
  box-shadow: none;
}

.searchInput::placeholder {
  color: var(--ink-500);
}

.searchClear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: none;
  background: var(--sand-200);
  color: var(--ink-700);
  cursor: pointer;
  flex-shrink: 0;
  padding: 0;
  transition: background 0.12s;
}

.searchClear:hover {
  background: var(--sand-200);
  color: var(--ink-900);
}

/* Divider */
.barDivider {
  width: 1px;
  height: 22px;
  background: var(--sand-200);
  flex-shrink: 0;
  margin: 0 2px;
}

/* ── Dropdown filter ── */
.dropdown {
  position: relative;
}

.dropdownTrigger {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 12px;
  border-radius: 10px;
  border: none;
  background: transparent;
  color: var(--ink-700);
  font-size: 13px;
  font-family: inherit;
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.15s ease, color 0.15s ease;
}

.dropdownTrigger:hover {
  background: var(--sand-100);
  color: var(--ink-900);
}

.dropdownTriggerActive {
  background: rgba(15, 143, 141, 0.1);
  color: var(--teal-700);
  font-weight: 500;
}

.dropdownTriggerActive:hover {
  background: rgba(15, 143, 141, 0.15);
}

.chevron {
  transition: transform 0.18s ease;
  color: var(--ink-500);
}

.chevronOpen {
  transform: rotate(180deg);
}

.dropdownMenu {
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  z-index: 200;
  min-width: 180px;
  max-height: 280px;
  overflow-y: auto;
  background: #ffffff;
  border: 1px solid var(--sand-200);
  border-radius: 14px;
  box-shadow: 0 12px 40px rgba(15, 34, 52, 0.14);
  padding: 6px;
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.dropdownOption {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 10px;
  border-radius: 8px;
  border: none;
  background: transparent;
  color: var(--ink-700);
  font-size: 13px;
  font-family: inherit;
  cursor: pointer;
  text-align: left;
  transition: background 0.1s ease;
}

.dropdownOption:hover {
  background: var(--sand-100);
}

.dropdownOptionSelected {
  color: var(--teal-700);
  font-weight: 500;
}

.optionCheck {
  width: 16px;
  height: 16px;
  border-radius: 4px;
  border: 1.5px solid var(--sand-200);
  background: var(--sand-100);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--teal-500);
  transition: background 0.12s, border-color 0.12s;
}

.dropdownOptionSelected .optionCheck {
  background: var(--teal-500);
  border-color: var(--teal-500);
  color: #ffffff;
}

/* Sort */
.sortWrap {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 8px;
}

.sortSelect {
  border: none;
  outline: none;
  background: transparent;
  font-size: 13px;
  font-family: inherit;
  color: var(--ink-700);
  cursor: pointer;
  appearance: none;
  -webkit-appearance: none;
}

/* Clear button */
.clearBtn {
  padding: 6px 12px;
  border-radius: 8px;
  border: none;
  background: transparent;
  color: var(--coral-500);
  font-size: 12.5px;
  font-family: inherit;
  cursor: pointer;
  font-weight: 500;
  transition: background 0.12s;
  white-space: nowrap;
}

.clearBtn:hover {
  background: rgba(224, 110, 72, 0.08);
}

/* ── Active chips row ── */
.activeChips {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
}

.activeChip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 10px 4px 12px;
  border-radius: 999px;
  background: rgba(15, 143, 141, 0.09);
  border: 1px solid rgba(15, 143, 141, 0.2);
  color: var(--teal-700);
  font-size: 12px;
  font-weight: 500;
}

.chipRemove {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 15px;
  height: 15px;
  border-radius: 50%;
  border: none;
  background: rgba(10, 109, 107, 0.15);
  color: var(--teal-700);
  cursor: pointer;
  padding: 0;
  transition: background 0.12s;
}

.chipRemove:hover {
  background: rgba(10, 109, 107, 0.28);
}

.matchCount {
  font-size: 12px;
  color: var(--ink-500);
  margin-left: 4px;
}

/* ── Results ── */
.results {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.resultsHeader {
  display: flex;
  align-items: center;
  gap: 10px;
}

.resultsCount {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: 8px;
  padding: 2px 9px;
  border-radius: 999px;
  background: var(--sand-200);
  color: var(--ink-500);
  font-size: 13px;
  font-weight: 500;
  font-family: var(--font-body), sans-serif;
  vertical-align: middle;
}

/* ── Buttons ── */
.primaryButton {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--teal-500);
  color: #ffffff;
  border: none;
  padding: 10px 18px;
  border-radius: 12px;
  font-size: 13px;
  font-family: inherit;
  cursor: pointer;
  box-shadow: 0 8px 20px rgba(15, 143, 141, 0.22);
  transition: transform 0.18s ease, background 0.18s ease;
  text-decoration: none;
}

.primaryButton:hover {
  background: var(--teal-700);
  transform: translateY(-1px);
}

/* Icon-only bookmark action next to "View details" — a text pill here
   duplicated the primary CTA's visual weight for a secondary action.
   The icon communicates "save" at a glance without competing for attention. */
.bookmarkActionBtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  padding: 0;
  border-radius: 12px;
  background: var(--sand-100);
  border: 1px solid var(--sand-200);
  color: var(--ink-700);
  cursor: pointer;
  transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
}

.bookmarkActionBtn:hover {
  background: var(--sand-200);
}

.bookmarkActionBtn:active {
  transform: scale(0.93);
}

.bookmarkActive {
  background: rgba(15, 143, 141, 0.1);
  color: var(--teal-700);
  border: 1.5px solid rgba(15, 143, 141, 0.22);
}

/* ── Cards ── */
.cardGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.card {
  position: relative;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 20px;
  padding: 18px;
  border: 1px solid var(--sand-200);
  display: flex;
  flex-direction: column;
  gap: 14px;
  box-shadow: 0 16px 32px rgba(15, 34, 52, 0.08);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.card:hover {
  transform: translateY(-2px);
  box-shadow: 0 22px 44px rgba(15, 34, 52, 0.12);
}

/* ── Flagship card ── */
.cardFlagship {
  border-color: rgba(245, 158, 11, 0.45);
  box-shadow:
    0 0 0 1.5px rgba(245, 158, 11, 0.22),
    0 16px 32px rgba(15, 34, 52, 0.08);
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.97) 0%,
    rgba(255, 251, 235, 0.9) 100%
  );
}

.cardFlagship:hover {
  box-shadow:
    0 0 0 2px rgba(245, 158, 11, 0.3),
    0 22px 44px rgba(15, 34, 52, 0.14);
}

.flagshipBadge {
  position: absolute;
  bottom: 10px;
  left: 10px;
  z-index: 3;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 10px;
  border-radius: 999px;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: #ffffff;
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.25);
  pointer-events: none;
}

/* Fallback when there's no thumbnail — sits in the card corner */
.flagshipBadgeCorner {
  position: absolute;
  top: 14px;
  left: 14px;
  z-index: 3;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 10px;
  border-radius: 999px;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: #ffffff;
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  box-shadow: 0 3px 10px rgba(245, 158, 11, 0.35);
  pointer-events: none;
}

/* Wrapper that gives the thumbnail a positioning context for the badge */
.thumbWrap {
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: -4px;
}

.thumbWrap .cardThumb {
  margin-bottom: 0;
  border-radius: 0;
  display: block;
}


/* Stretched link covers the whole card on mobile (whole-card tap target).
   Hidden on desktop where the explicit "View details" button does the job. */
.cardLink {
  display: none;
}

/* Compact icon-only bookmark button — only shown on mobile in the card corner */
.bookmarkIcon {
  display: none;
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 2;
  width: 36px;
  height: 36px;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  border: 1px solid var(--sand-200);
  color: var(--ink-700);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  box-shadow: 0 2px 8px rgba(15, 34, 52, 0.08);
  transition: color 0.2s ease, transform 0.15s ease, background 0.2s ease;
}

.bookmarkIcon:active {
  transform: scale(0.92);
}

.bookmarkIconActive {
  color: var(--teal-700);
  background: rgba(15, 143, 141, 0.12);
  border-color: rgba(15, 143, 141, 0.25);
}

.cardTop {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: flex-start;
}

.cardLabel {
  font-size: 11px;
  color: var(--teal-700);
  text-transform: uppercase;
  letter-spacing: 1.4px;
  margin-bottom: 6px;
}

/* Reserve space for 2 lines up front — titles that fit on 1 line no longer
   leave the row shorter than a 2-line neighbor, which is what was causing
   the action row to land at a different height card to card. */
.card h3 {
  font-size: 16px;
  line-height: 1.35;
  font-weight: 700;
  min-height: calc(1.35em * 2);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.cardMeta {
  font-size: 12px;
  color: var(--ink-500);
  margin-top: 6px;
}

.deadline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-width: 116px;
  max-width: 160px;
  padding: 6px 10px;
  border-radius: 10px;
  font-size: 12px;
  line-height: 1.3;
  color: var(--coral-500);
  font-weight: 600;
  background: rgba(255, 120, 92, 0.12);
  white-space: normal;
  text-align: center;
  flex-shrink: 0;
  align-self: flex-start;
}

.deadlineSoon {
  color: #c0392b;
  background: rgba(220, 53, 69, 0.18);
}

.deadlineClosed {
  color: #8a3a2a;
  background: rgba(160, 60, 40, 0.1);
  text-decoration: line-through;
  opacity: 0.75;
}

.cardThumb {
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
  max-height: 160px;
  object-fit: cover;
  border-radius: 12px;
  margin-bottom: -4px;
}

.tagRow {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.tagRow span {
  padding: 5px 10px;
  border-radius: 999px;
  background: var(--sand-100);
  font-size: 11px;
  color: var(--ink-700);
}

.tagMore {
  background: transparent !important;
  border: 1px solid var(--sand-200);
  color: var(--ink-500);
  font-weight: 600;
}

.cardActions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  /* Push the action row to the bottom of the card regardless of how many
     lines the title/tags above take up, so buttons line up across a grid
     row even when neighboring cards have 1-line vs 2-line titles. */
  margin-top: auto;
}

.emptyState {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
  padding: 24px;
  border-radius: 18px;
  border: 1px dashed var(--sand-200);
  background: rgba(255, 255, 255, 0.85);
}

.emptyHint {
  font-size: 13px;
  color: var(--ink-500);
}

.emptySuggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.suggestionPill {
  border: 1px solid var(--sand-200);
  border-radius: 999px;
  padding: 6px 12px;
  background: #ffffff;
  font-size: 12px;
  color: var(--ink-700);
  cursor: pointer;
  transition: border 0.15s ease, color 0.15s ease, transform 0.15s ease;
}

.suggestionPill:hover {
  border-color: var(--teal-500);
  color: var(--teal-700);
  transform: translateY(-1px);
}

/* ── Section dividers (Live / Upcoming) ── */
.sectionLiveDot,
.sectionUpcomingDot {
  display: inline-block;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  margin-right: 8px;
  vertical-align: middle;
  flex-shrink: 0;
}

.sectionLiveDot {
  background: var(--teal-500, #0f8f8d);
  box-shadow: 0 0 0 3px rgba(15, 143, 141, 0.18);
  animation: livePulse 2s ease-in-out infinite;
}

.sectionUpcomingDot {
  background: var(--amber-400, #f59e0b);
  box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.18);
}

@keyframes livePulse {
  0%, 100% { box-shadow: 0 0 0 3px rgba(15, 143, 141, 0.18); }
  50% { box-shadow: 0 0 0 5px rgba(15, 143, 141, 0.08); }
}

.sectionSubtitle {
  font-size: 13px;
  color: var(--ink-500);
  margin: 2px 0 0;
}

/* Mobile-only stand-in for the hero snapshot panel's total count — hidden
   on desktop where the panel itself already shows it. Styled as a small
   pulsing "live" chip (echoing .sectionLiveDot / .liveBadge) rather than
   plain text, so it reads as a highlight instead of filler copy. */
.mobileTrackedNote {
  display: none;
}

.mobileTrackedNote strong {
  font-weight: 800;
  color: var(--teal-800);
}

.mobileTrackedDot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--teal-500);
  box-shadow: 0 0 0 3px rgba(15, 143, 141, 0.18);
  animation: livePulse 2s ease-in-out infinite;
  flex-shrink: 0;
}

/* Upcoming card variant — slightly muted */
.cardUpcoming {
  opacity: 0.92;
}

.cardUpcoming::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  border: 1.5px dashed rgba(245, 158, 11, 0.35);
  pointer-events: none;
}

/* Closed card variant */
.cardClosed {
  opacity: 0.72;
  filter: grayscale(0.35);
}

.cardClosed::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  border: 1.5px dashed rgba(120, 110, 100, 0.3);
  pointer-events: none;
}

/* Upcoming badge on thumbnail */
.upcomingBadge {
  position: absolute;
  top: 10px;
  left: 10px;
  background: rgba(245, 158, 11, 0.92);
  color: #fff;
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.5px;
  padding: 3px 9px;
  border-radius: 999px;
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}

/* Closed badge on thumbnail */
.closedBadge {
  position: absolute;
  top: 10px;
  left: 10px;
  background: rgba(80, 70, 60, 0.82);
  color: #fff;
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.5px;
  padding: 3px 9px;
  border-radius: 999px;
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}

/* Section dot for recently closed */
.sectionClosedDot {
  display: inline-block;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  margin-right: 8px;
  vertical-align: middle;
  flex-shrink: 0;
  background: var(--ink-400, #9e9589);
  box-shadow: 0 0 0 3px rgba(120, 110, 100, 0.12);
}

/* Deadline badge for upcoming scholarships */
.deadlineUpcoming {
  background: rgba(245, 158, 11, 0.1);
  color: var(--amber-700, #b45309);
  border-color: rgba(245, 158, 11, 0.3);
}

/* ── Responsive ── */
@media (max-width: 1100px) {
  .hero {
    grid-template-columns: 1fr;
  }
  .cardGrid {
    grid-template-columns: 1fr;
  }

  /* The 2-line reservation on the title only earns its keep in the 2-column
     grid above, where sibling cards sit side by side and need matching
     heights. Single-column below this point — no neighbor to align with,
     so a 1-line title shouldn't carry a phantom second line of blank space. */
  .card h3 {
    min-height: 0;
  }
}

@media (max-width: 820px) {
  .filterBar {
    gap: 2px;
  }
}

/* Sticky filter bar on mobile so the search/filters are always reachable
   while scrolling the catalog. */
@media (max-width: 720px) {
  .filterBar {
    position: sticky;
    top: 8px;
    z-index: 30;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: saturate(180%) blur(10px);
    -webkit-backdrop-filter: saturate(180%) blur(10px);
    box-shadow: 0 6px 18px -8px rgba(15, 34, 52, 0.12);
  }

  /* Mobile hero is heavily compressed — users came for scholarships,
     not marketing copy. Keep just a short title; everything else hides. */
  .hero {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .hero .kicker,
  .hero .subtitle {
    display: none;
  }

  .heroTitleFull {
    display: none;
  }

  .heroTitleShort {
    display: inline;
  }

  .hero h1 {
    font-size: 1.25rem;
    margin: 0 0 12px;
    line-height: 1.2;
  }

  /* Drop the snapshot panel on mobile — it competes with the catalog below
     for the same real estate the first tap should go to. The one figure
     worth keeping (total tracked count) moves into the "Open Now" header
     instead, via .mobileTrackedNote. */
  .heroPanel {
    display: none;
  }

  /* Force the chip onto its own full-width line above the heading, whether
     .resultsHeader is currently row (tablet) or column (phone) layout. */
  .resultsHeader {
    flex-wrap: wrap;
  }

  .mobileTrackedNote {
    display: inline-flex;
    order: -1;
    flex-basis: 100%;
    align-items: center;
    gap: 7px;
    align-self: flex-start;
    margin: 0 0 10px;
    padding: 6px 13px 6px 10px;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(15, 143, 141, 0.14), rgba(15, 143, 141, 0.05));
    border: 1px solid rgba(15, 143, 141, 0.22);
    font-size: 12px;
    font-weight: 600;
    color: var(--teal-700);
  }
}

@media (max-width: 640px) {
  .page {
    padding: 16px 5vw 50px;
    gap: 16px;
  }
  .main {
    gap: 14px;
  }
  .filterBar {
    border-radius: 14px;
  }
  .resultsHeader {
    flex-direction: column;
    align-items: flex-start;
  }

  /* .resultsHeader is now a column, so the main axis is vertical — the
     100% flex-basis set at 720px (meant to force a full-width row in the
     tablet row-layout) would otherwise be read as a 100%-height basis here. */
  .mobileTrackedNote {
    flex-basis: auto;
  }

  /* ── Compact card for mobile ────────────────────────────────────────── */
  .card {
    padding: 0;
    gap: 0;
    overflow: hidden;
    /* Border-radius cleaner without extra padding around the image */
    border-radius: 18px;
  }

  /* Whole card becomes a tap target — covers everything beneath */
  .cardLink {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    -webkit-tap-highlight-color: rgba(15, 143, 141, 0.06);
  }

  /* Image fills full width, capped height — keeps aspirational visual */
  .cardThumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 160px;
    object-fit: cover;
    border-radius: 0;
    margin-bottom: 0;
  }

  /* Bookmark icon — overlay on top-right of the thumbnail.
     White-glass background so it stays readable on any image. */
  .bookmarkIcon {
    display: flex;
    top: 10px;
    right: 10px;
    z-index: 3;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  /* Text content sits below the image with consistent inner padding */
  .cardTop {
    flex-direction: column;
    gap: 8px;
    padding: 14px 16px 0;
  }

  .cardLabel {
    margin-bottom: 4px;
  }

  .card h3 {
    font-size: 15px;
    line-height: 1.3;
    /* Cap title to 2 lines so cards stay equal-height */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cardMeta {
    margin-top: 0;
    font-size: 12px;
  }

  .deadline {
    align-self: flex-start;
    min-width: 0;
    font-size: 11.5px;
    padding: 4px 9px;
  }

  /* Hide the chip-tag wall on mobile — too noisy, full tag list lives
     on the detail page anyway */
  .tagRow {
    display: none;
  }

  /* Single full-width primary action; the bookmark icon overlay replaces
     the secondary "Bookmark" button. */
  .cardActions {
    padding: 12px 16px 16px;
    gap: 0;
  }

  .cardActions .bookmarkActionBtn {
    display: none;
  }

  .cardActions .primaryButton {
    width: 100%;
    text-align: center;
    padding: 10px 14px;
    font-size: 13.5px;
    /* Sits above .cardLink so the explicit button still works as a tap target */
    position: relative;
    z-index: 2;
  }
}

/* ── Telegram Popup ───────────────────────────────────────────────────────── */
.popupBackdrop {
  position: fixed;
  inset: 0;
  background: rgba(10, 22, 36, 0.55);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  z-index: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  opacity: 0;
  transition: opacity 0.28s ease;
}

.popupBackdropVisible {
  opacity: 1;
}

.popupCard {
  position: relative;
  background: var(--surface, #fff);
  border-radius: 20px;
  overflow: hidden;
  width: 100%;
  max-width: 400px;
  box-shadow:
    0 24px 64px -12px rgba(10, 22, 36, 0.38),
    0 4px 16px rgba(10, 22, 36, 0.12);
  transform: translateY(24px) scale(0.97);
  transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.28s ease;
  opacity: 0;
}

.popupCardVisible {
  transform: translateY(0) scale(1);
  opacity: 1;
}

.popupClose {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 10;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(10, 22, 36, 0.55);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  transition: background 0.18s ease, transform 0.15s ease;
}

.popupClose:hover {
  background: rgba(10, 22, 36, 0.78);
  transform: scale(1.08);
}

.popupClose:active {
  transform: scale(0.94);
}

.popupImageWrap {
  width: 100%;
  max-height: 320px;
  overflow: hidden;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.popupImage {
  width: 100%;
  height: auto;
  object-fit: cover;
  object-position: top center;
  display: block;
}

.popupBody {
  padding: 20px 22px 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  align-items: center;
  text-align: center;
}

.popupText {
  font-family: var(--font-bengali, sans-serif);
  font-size: 16px;
  font-weight: 600;
  line-height: 1.55;
  color: var(--ink-900, #0e1e2e);
  margin: 0;
}

.popupTelegramBtn {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  background: #229ED9;
  color: #fff;
  font-family: var(--font-bengali, sans-serif);
  font-size: 15px;
  font-weight: 600;
  padding: 12px 24px;
  border-radius: 50px;
  text-decoration: none;
  transition: background 0.18s ease, transform 0.15s ease, box-shadow 0.18s ease;
  box-shadow: 0 4px 16px -4px rgba(34, 158, 217, 0.55);
  width: 100%;
  justify-content: center;
}

.popupTelegramBtn:hover {
  background: #1a8bbf;
  transform: translateY(-1px);
  box-shadow: 0 8px 24px -6px rgba(34, 158, 217, 0.6);
}

.popupTelegramBtn:active {
  transform: translateY(0);
}

@media (prefers-reduced-motion: reduce) {
  .popupBackdrop,
  .popupCard {
    transition: none;
  }
}

@media (max-width: 480px) {
  .popupCard {
    border-radius: 16px;
    max-width: 100%;
  }

  .popupImageWrap {
    max-height: 260px;
  }

  .popupBody {
    padding: 16px 18px 20px;
  }

  .popupText {
    font-size: 15px;
  }
}
