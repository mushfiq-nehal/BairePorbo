  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.25rem;
}

.faqSectionTitle {
  font-size: 1rem;
  font-weight: 700;
  color: var(--ink-900);
}

.faqCount {
  font-size: 0.8rem;
  color: var(--ink-500);
}

/* ── Accordion ── */
.accordion {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-bottom: 3rem;
}

.accordionItem {
  background: #fff;
  border: 1.5px solid var(--sand-200);
  border-radius: 12px;
  overflow: hidden;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.accordionItem:hover {
  border-color: rgba(15, 143, 141, 0.3);
}

.accordionItemOpen {
  border-color: rgba(15, 143, 141, 0.45);
  box-shadow: 0 4px 20px rgba(15, 143, 141, 0.08);
}

.accordionTrigger {
  width: 100%;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.1rem 1.25rem;
  background: none;
  border: none;
  cursor: pointer;
  text-align: left;
  font-family: inherit;
  transition: background 0.15s;
}

.accordionTrigger:hover {
  background: var(--sand-100);
}

.accordionItemOpen .accordionTrigger {
  background: rgba(15, 143, 141, 0.04);
}

.accordionQ {
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--ink-900);
  line-height: 1.5;
}

.accordionIcon {
  font-size: 1.25rem;
  font-weight: 400;
  color: var(--teal-500);
  flex-shrink: 0;
  line-height: 1;
  margin-top: 2px;
  width: 20px;
  text-align: center;
}

.accordionPanel {
  padding: 0 1.25rem 1.25rem;
  animation: fadeSlideIn 0.18s ease;
}

@keyframes fadeSlideIn {
  from {
    opacity: 0;
    transform: translateY(-4px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.accordionAnswer {
  font-size: 0.9375rem;
  color: var(--ink-700);
  line-height: 1.75;
}

/* ── Bottom CTA ── */
.bottomCta {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1.25rem 1.5rem;
  background: var(--sand-100);
  border-radius: 12px;
  border: 1px solid var(--sand-200);
  flex-wrap: wrap;
}

.bottomCta p {
  font-size: 0.9375rem;
  color: var(--ink-700);
  flex: 1;
}

.mentorLink {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--teal-500);
  white-space: nowrap;
  transition: color 0.15s;
}

.mentorLink:hover {
  color: var(--teal-700);
}

/* ── Sidebar ── */
.sidebar {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  position: sticky;
  top: 5rem;
}

.sidebarCard,
.sidebarMentorCard,
.relatedCard,
.scholarshipsCard {
  background: #fff;
  border: 1.5px solid var(--sand-200);
  border-radius: 14px;
  padding: 1.25rem;
}

.sidebarKicker {
  font-size: 0.725rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--ink-500);
  margin-bottom: 0.75rem;
}

/* Table of contents */
.tocList {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  max-height: 260px;
  overflow-y: auto;
}

.tocLink {
  display: block;
  font-size: 0.8125rem;
  color: var(--ink-700);
  line-height: 1.45;
  padding: 0.2rem 0;
  transition: color 0.15s;
  border-bottom: none;
}

.tocLink:hover {
  color: var(--teal-500);
}

/* Mentor card */
.sidebarMentorCard {
  background: linear-gradient(135deg, #0a4a48, #0f8f8d);
