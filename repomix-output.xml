.page {
  height: 100vh;
  height: 100dvh;
  display: grid;
  grid-template-columns: 320px minmax(0, 1fr);
  /* Without an explicit row track, the implicit "auto" row sizes to the
     tallest child's content height (e.g. a long session history list)
     instead of shrinking to fit the viewport — the grid equivalent of the
     flex min-height:0 issue below. That pushes/clips the sidebar and chat
     window past the visible page instead of letting them scroll internally. */
  grid-template-rows: minmax(0, 1fr);
  background: rgba(255, 255, 255, 0.6);
  overflow: hidden;
}

.sidebar {
  background: rgba(255, 255, 255, 0.92);
  border-right: 1px solid var(--sand-200);
  display: flex;
  flex-direction: column;
  padding: 24px 20px;
  gap: 20px;
}

.sidebarHeader {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brandLogo {
  border-radius: 6px;
}

.brandName {
  font-family: var(--font-display), var(--font-bengali), sans-serif;
  font-size: 18px;
}

.brandTag {
  font-size: 12px;
  color: var(--ink-500);
}

.sidebarBrandRow {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mobileSidebarToggle {
  display: none;
