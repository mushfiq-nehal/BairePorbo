}

.sidebarMentorText {
  font-size: 0.8125rem;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.55;
  margin-bottom: 1rem;
}

.sidebarMentorCta {
  display: block;
  background: rgba(255, 255, 255, 0.15);
  border: 1px solid rgba(255, 255, 255, 0.3);
  color: #fff;
  text-align: center;
  padding: 0.6rem 1rem;
  border-radius: 8px;
  font-size: 0.875rem;
  font-weight: 600;
  transition: background 0.2s;
  text-decoration: none;
}

.sidebarMentorCta:hover {
  background: rgba(255, 255, 255, 0.25);
}

/* Related guides */
.relatedList {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.relatedLink {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.5rem;
  font-size: 0.8125rem;
  color: var(--ink-700);
  line-height: 1.45;
  padding: 0.35rem 0;
  border-bottom: 1px solid var(--sand-100);
  transition: color 0.15s;
}

.relatedLink:last-child {
  border-bottom: none;
}

.relatedLink:hover {
  color: var(--teal-500);
}

.relatedArrow {
  flex-shrink: 0;
  color: var(--teal-500);
}

/* Scholarships CTA */
.scholarshipsText {
  font-size: 0.8125rem;
  color: var(--ink-500);
  line-height: 1.55;
  margin-bottom: 0.75rem;
}

.scholarshipsLink {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--teal-500);
  transition: color 0.15s;
}

.scholarshipsLink:hover {
  color: var(--teal-700);
}

/* ── Responsive ── */
@media (max-width: 900px) {
  .layout {
    grid-template-columns: 1fr;
  }

  .sidebar {
    position: static;
    /* On mobile, show sidebar after the article body */
    order: 2;
  }

  .article {
    order: 1;
  }

  /* Collapse TOC on mobile */
  .sidebarCard {
    display: none;
  }
}

@media (max-width: 640px) {
  .main {
    padding: 1.5rem 1.25rem 3rem;
  }

  .articleTitle {
    font-size: 1.5rem;
  }
}
