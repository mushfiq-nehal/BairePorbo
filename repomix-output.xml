  color: #b14a2a;
}

.action_urgent .actionCta {
  background: var(--coral-500);
}

.action_urgent .actionCta:hover {
  background: #c95730;
}

.action_profile .actionLabel {
  color: var(--teal-700);
}

.action_explore .actionLabel,
.action_fresh .actionLabel,
.action_default .actionLabel {
  color: var(--teal-700);
}

/* ── Generic panel ── */
.panel {
  position: relative;
  background: #ffffff;
  border: 1px solid var(--sand-200);
  border-radius: 20px;
  padding: 22px 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  box-shadow: 0 4px 18px rgba(15, 34, 52, 0.05);
}

.panelHeader {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.panelHeadingGroup {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  min-width: 0;
}

.panelIcon {
  width: 38px;
  height: 38px;
  border-radius: 11px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1px solid var(--sand-200);
}

.panelIcon svg {
  width: 19px;
  height: 19px;
}

.panelIcon[data-tone="teal"] {
  background: var(--teal-100);
  color: var(--teal-700);
  border-color: var(--teal-200);
}

.panelIcon[data-tone="coral"] {
  background: var(--coral-100);
  color: var(--coral-700);
  border-color: #f4cdbf;
}

.panelIcon[data-tone="sand"] {
  background: var(--sand-100);
  color: var(--ink-700);
}

.panelHeader h3 {
  font-family: var(--font-display), var(--font-bengali), sans-serif;
  font-size: 18px;
  font-weight: 700;
  color: var(--ink-900);
  letter-spacing: -0.2px;
}

.readinessNum {
  font-size: 1.2em;
  color: var(--teal-700);
}

.linkButton {
  background: transparent;
  border: none;
  color: var(--teal-700);
  font-size: 12.5px;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
  padding: 0;
}

.linkButton:hover:not(:disabled) {
  text-decoration: underline;
}

.linkButton:disabled {
  color: var(--ink-500);
  cursor: not-allowed;
}

.linkInline {
  color: var(--teal-700);
  font-weight: 600;
  text-decoration: none;
}

.linkInline:hover {
  text-decoration: underline;
}

.muted {
  font-size: 13px;
  color: var(--ink-500);
  line-height: 1.55;
  margin: 0;
}

.muted strong {
  color: var(--ink-700);
}

/* Two-column rows */
.row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 20px;
}

.liveDot {
  display: inline-block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #e63946;
  box-shadow: 0 0 0 0 rgba(230, 57, 70, 0.6);
  animation: liveBeat 1.6s ease-in-out infinite;
}

@keyframes liveBeat {
  0%, 100% { box-shadow: 0 0 0 0 rgba(230, 57, 70, 0.55); }
  70%      { box-shadow: 0 0 0 5px rgba(230, 57, 70, 0); }
}

/* ── AI Match list ── */
.matchList {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.matchItem {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  border-radius: 14px;
  border: 1px solid transparent;
  text-decoration: none;
  color: inherit;
  transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
}

.matchItem:hover {
  background: var(--sand-100, #f7f3ee);
  border-color: var(--sand-200);
  transform: translateY(-1px);
}

.matchThumb {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--teal-500), var(--coral-400));
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  color: #ffffff;
  overflow: hidden;
}

.matchThumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.matchBody {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.matchBody h4 {
  font-size: 14px;
  font-weight: 700;
  color: var(--ink-900);
  margin: 0;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.matchBody p {
  font-size: 12px;
  color: var(--ink-500);
  margin: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.matchArrow {
  color: var(--ink-500);
  font-size: 14px;
  flex-shrink: 0;
  transition: transform 0.2s ease, color 0.2s ease;
}

.matchItem:hover .matchArrow {
  color: var(--teal-700);
  transform: translateX(2px);
}

.matchEmpty {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 14px 16px;
  border-radius: 12px;
  background: var(--sand-100, #f7f3ee);
  border: 1px dashed var(--sand-200);
  font-size: 13px;
  color: var(--ink-500);
  line-height: 1.55;
}

.matchEmpty p {
  margin: 0;
}

/* ── Deadline list ── */
.deadlineList {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.deadlineItem {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 12px 14px;
  border-radius: 12px;
  border: 1px solid var(--sand-200);
  border-left: 3px solid var(--teal-200);
  background: #ffffff;
  text-decoration: none;
  color: inherit;
  transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
}

.deadlineItem:hover {
  transform: translateY(-1px);
  border-color: var(--teal-500);
  box-shadow: 0 8px 22px rgba(15, 143, 141, 0.1);
}

.deadlineItem h4 {
  font-size: 13.5px;
  font-weight: 700;
  color: var(--ink-900);
  margin: 0 0 2px;
  line-height: 1.3;
}

.deadlineItem p {
  font-size: 12px;
  color: var(--ink-500);
  margin: 0;
}

.deadlineBadge {
  flex-shrink: 0;
  padding: 4px 10px;
  border-radius: 999px;
  background: rgba(15, 143, 141, 0.1);
  border: 1px solid rgba(15, 143, 141, 0.2);
  color: var(--teal-700);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.4px;
  text-transform: uppercase;
}

.deadlineItemUrgent {
  border-color: rgba(240, 138, 104, 0.4);
  border-left-color: var(--coral-500);
}

.deadlineItemUrgent .deadlineBadge {
  background: rgba(240, 138, 104, 0.18);
  border-color: rgba(240, 138, 104, 0.4);
  color: #b14a2a;
}

/* ── Profile progress ── */
.progressTrack {
  width: 100%;
  height: 12px;
  background: rgba(15, 143, 141, 0.08);
  border-radius: 999px;
  overflow: hidden;
}

.progressFill {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--teal-500), var(--coral-400));
  transition: width 0.4s ease;
}

.profileCta {
  align-self: stretch;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin-top: 4px;
  padding: 11px 18px;
  border-radius: 12px;
  background: var(--teal-500);
  color: #ffffff;
  font-size: 13.5px;
  font-weight: 600;
  text-decoration: none;
  text-align: center;
  transition: background 0.2s ease, transform 0.2s ease;
}

.profileCta:hover {
  background: var(--teal-700);
  transform: translateY(-1px);
}

.signOutBtn {
  align-self: stretch;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 2px;
  padding: 9px 16px;
  border-radius: 12px;
  border: 1px solid var(--sand-200);
  background: transparent;
  color: var(--ink-500);
  font-size: 13px;
  font-family: inherit;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}

.signOutBtn:hover {
  background: rgba(220, 53, 69, 0.06);
  border-color: rgba(220, 53, 69, 0.25);
  color: #c0392b;
}

/* ── Last chat preview ── */
.lastSessionItem {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding: 14px 16px;
  border-radius: 14px;
  background: var(--sand-100, #f7f3ee);
  border: 1px solid var(--sand-200);
  text-decoration: none;
  color: inherit;
  transition: background 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
}

.lastSessionItem:hover {
  background: #ffffff;
  border-color: var(--teal-500);
  transform: translateY(-1px);
}

.lastSessionItem h4 {
  font-size: 14px;
  font-weight: 700;
  color: var(--ink-900);
  margin: 0 0 4px;
  line-height: 1.3;
}

.lastSessionPreview {
  font-size: 12.5px;
  color: var(--ink-500);
  margin: 0;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ── All bookmarks grid ── */
.bookmarkGrid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 12px;
  align-items: stretch;
}

.bookmarkGrid > li {
  display: flex;
}

.bookmarkCard {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 14px;
  border-radius: 14px;
  border: 1px solid var(--sand-200);
  background: #ffffff;
  text-decoration: none;
  color: inherit;
  transition: transform 0.2s ease, border-color 0.2s ease;
  width: 100%;
}

.bookmarkCard:hover {
  transform: translateY(-2px);
  border-color: var(--teal-500);
}

.bookmarkCard h4 {
  font-size: 13.5px;
  font-weight: 700;
  color: var(--ink-900);
  line-height: 1.3;
  margin: 0;
  /* Reserve room for at most 2 lines so titles of different lengths align */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: calc(1.3em * 2);
}

.bookmarkMeta {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
  font-size: 12px;
  color: var(--ink-500);
  margin: auto 0 0;
}

/* ── Responsive ── */
@media (max-width: 980px) {
  .heroStrip {
    grid-template-columns: 1fr;
    gap: 18px;
    padding: 28px 26px;
  }
}

@media (max-width: 820px) {
  .row {
    grid-template-columns: 1fr;
  }

  .actionCard {
    flex-direction: column;
    align-items: stretch;
  }

  .actionCta {
    align-self: stretch;
    text-align: center;
    justify-content: center;
  }
}

@media (max-width: 720px) {
  .page {
    padding: 22px 6vw 56px;
  }

  .heroStrip {
    border-radius: 22px;
    padding: 24px 20px;
  }

  .heroStat {
    font-size: 12px;
    padding: 6px 12px 6px 9px;
  }

  /* Show the mobile segmented control */
  .mobileTabs {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    background: rgba(15, 143, 141, 0.08);
    border-radius: 999px;
    margin: -4px 0 4px;
  }

  /* Show only the section matching the active mobile tab */
  .main[data-mobile-tab="today"] [data-mobile-section]:not([data-mobile-section="today"]) {
    display: none;
  }

  .main[data-mobile-tab="bookmarks"] [data-mobile-section]:not([data-mobile-section="bookmarks"]) {
    display: none;
  }

  .main[data-mobile-tab="profile"] [data-mobile-section]:not([data-mobile-section="profile"]) {
    display: none;
  }

  /* Tighter panel padding on small screens */
  .panel {
    padding: 16px;
  }

  /* Match items: shrink thumbnail, allow text to breathe */
  .matchThumb {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    font-size: 16px;
    flex-shrink: 0;
  }

  .matchItem {
    gap: 10px;
    padding: 10px;
  }

  .matchBody h4 {
    font-size: 13px;
    white-space: normal;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .matchBody p {
    font-size: 11.5px;
    white-space: normal;
    overflow: visible;
    text-overflow: unset;
  }

  /* Deadline items: stack content + badge on very small screens */
  .deadlineItem {
    align-items: flex-start;
    gap: 10px;
    flex-wrap: wrap;
  }

  .deadlineItem > div {
    flex: 1;
    min-width: 0;
  }

  .deadlineItem h4 {
    font-size: 13px;
    white-space: normal;
    line-height: 1.35;
  }

  .deadlineBadge {
    align-self: flex-start;
    font-size: 10px;
    padding: 3px 8px;
  }

  /* Bookmark grid: single column on small screens */
  .bookmarkGrid {
    grid-template-columns: 1fr;
  }
}

/* ── CV Builder promo ─────────────────────────────────────── */
.cvPromo {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  flex-wrap: wrap;
  text-decoration: none;
  background: linear-gradient(135deg, var(--teal-700), var(--teal-500));
  color: #fff;
  border-radius: var(--radius-lg);
