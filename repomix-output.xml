}
.cvPromoIcon {
  width: 44px;
  height: 44px;
  border-radius: 13px;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.16);
  border: 1px solid rgba(255, 255, 255, 0.28);
  color: #fff;
}
.cvPromoIcon svg {
  width: 22px;
  height: 22px;
}
.cvPromoBody {
  flex: 1;
  min-width: 220px;
}
.cvPromoBody h3 {
  margin: 2px 0 4px;
  font-size: 20px;
}
.cvPromoKicker {
  margin: 0;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.85;
}
.cvPromoDesc {
  margin: 0;
