/* ── Markdown body ─────────────────────────────────────────── */
.markdownBody {
  font-size: 13px;
  color: var(--ink-900);
  line-height: 1.65;
}

.markdownBody > * + * {
  margin-top: 0.55em;
}

/* Headings */
.markdownBody h1,
.markdownBody h2,
.markdownBody h3,
.markdownBody h4,
.markdownBody h5,
.markdownBody h6 {
  font-family: var(--font-display), var(--font-bengali), sans-serif;
  font-weight: 700;
  line-height: 1.3;
  margin-top: 0.9em;
