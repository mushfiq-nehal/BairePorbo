  border: none;
  color: #c0cfe0;
  font-size: 0.85em;
  padding: 0;
}

/* Blockquotes */
.markdownBody blockquote {
  border: 1px solid rgba(15, 143, 141, 0.15);
  padding: 8px 14px;
  margin: 0.5em 0;
  color: var(--ink-700);
  font-style: italic;
  background: rgba(15, 143, 141, 0.05);
  border-radius: var(--radius-sm);
}

/* Horizontal rule */
.markdownBody hr {
  border: none;
  border-top: 1px solid var(--sand-200);
  margin: 0.8em 0;
}

/* Tables */
.markdownBody table {
  width: 100%;
  border-collapse: collapse;
  border: 1px solid var(--sand-200);
  border-radius: 8px;
  overflow: hidden;
  display: block;
  max-width: 100%;
  overflow-x: auto;
}

.markdownBody thead {
  background: rgba(15, 143, 141, 0.08);
}

.markdownBody th,
.markdownBody td {
  text-align: left;
  padding: 8px 10px;
  border-bottom: 1px solid var(--sand-200);
  font-size: 12px;
  color: var(--ink-900);
}

.markdownBody th {
  font-weight: 700;
  font-size: 12px;
}

.markdownBody tr:last-child td {
  border-bottom: none;
}

/* Links */
.markdownBody a {
  color: var(--teal-700);
  text-decoration: underline;
  text-underline-offset: 2px;
}

/* Loading / typing indicator */
.loadingBubble {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 14px 18px;
}

.typingDot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--teal-500);
  animation: typingPulse 1.2s infinite ease-in-out;
}

.typingDot:nth-child(1) { animation-delay: 0s; }
.typingDot:nth-child(2) { animation-delay: 0.2s; }
.typingDot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingPulse {
  0%, 80%, 100% { transform: scale(0.85); opacity: 0.4; }
  40%            { transform: scale(1.1); opacity: 1; }
}

/* Error banner */
.errorBanner {
  background: rgba(220, 53, 69, 0.08);
  border: 1px solid rgba(220, 53, 69, 0.25);
  border-radius: 14px;
  padding: 10px 14px;
  font-size: 12px;
  color: #c0392b;
}

/* Rate-limit banner — friendlier than a plain error */
.rateLimitBanner {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px 16px;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(15, 143, 141, 0.08), rgba(240, 138, 104, 0.08));
  border: 1px solid rgba(15, 143, 141, 0.2);
  box-shadow: 0 4px 14px rgba(15, 143, 141, 0.08);
}

.rateLimitIcon {
  font-size: 22px;
  line-height: 1;
  flex-shrink: 0;
}

.rateLimitBody {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.rateLimitTitle {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--ink-900);
  margin: 0;
}

.rateLimitHint {
  font-size: 12px;
  color: var(--ink-500);
  margin: 0;
}

.rateLimitCta {
  display: inline-block;
  margin-top: 2px;
  font-size: 12.5px;
  font-weight: 700;
  color: var(--teal-700);
  text-decoration: none;
}

.rateLimitCta:hover {
  text-decoration: underline;
}

/* Status indicator */
.statusReady,
.statusLoading,
.statusStreaming,
.statusError {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-weight: 600;
  font-size: 12px;
}

.statusReady    { color: var(--teal-700); }
.statusLoading  { color: var(--coral-400); }
.statusStreaming{ color: var(--teal-500); }
.statusError    { color: #c0392b; }

.statusDot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 0 0 currentColor;
  position: relative;
}

.statusReady .statusDot {
  animation: statusBreathe 2.4s ease-in-out infinite;
}

.statusLoading .statusDot,
.statusStreaming .statusDot {
  animation: statusPulse 1.1s ease-in-out infinite;
}

.statusError .statusDot {
  animation: statusBlink 0.9s steps(2, end) infinite;
}

@keyframes statusBreathe {
  0%, 100% { opacity: 0.55; transform: scale(1); }
  50%      { opacity: 1; transform: scale(1.15); }
}

@keyframes statusPulse {
  0%   { box-shadow: 0 0 0 0 currentColor; opacity: 1; }
  70%  { box-shadow: 0 0 0 8px transparent; opacity: 0.85; }
  100% { box-shadow: 0 0 0 0 transparent; opacity: 1; }
}

@keyframes statusBlink {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.3; }
}

@media (prefers-reduced-motion: reduce) {
  .statusReady .statusDot,
  .statusLoading .statusDot,
  .statusStreaming .statusDot,
  .statusError .statusDot {
    animation: none;
  }
}

.suggestions {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.suggestionLabel {
  font-size: 12px;
  color: var(--ink-500);
}

.suggestionGrid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.suggestionChip {
  border: 1px solid var(--sand-200);
  border-radius: 999px;
  padding: 8px 12px;
  background: #ffffff;
  font-size: 12px;
  cursor: pointer;
}

.inputBar {
  display: flex;
  align-items: flex-end;
  gap: 16px;
  background: rgba(255, 255, 255, 0.95);
  border: 1px solid var(--sand-200);
  border-radius: 18px;
  padding: 12px;
}

.inputLabel {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 12px;
  color: var(--ink-500);
  flex: 1;
}

.inputLabel textarea {
  border: 1px solid var(--sand-200);
  border-radius: 14px;
  padding: 10px 12px;
  font-size: 13px;
  font-family: inherit;
  resize: none;
  min-height: 44px;
  max-height: 160px;
  overflow-y: auto;
  line-height: 1.5;
}

.inputActions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.anonQuotaChip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 500;
  color: var(--ink-700);
  background: rgba(15, 143, 141, 0.08);
  border: 1px solid rgba(15, 143, 141, 0.2);
  white-space: nowrap;
}

.anonQuotaChip a {
  color: var(--teal-700);
  font-weight: 700;
  text-decoration: none;
}

.anonQuotaChip a:hover {
  text-decoration: underline;
}

.anonQuotaChipLow {
  color: #b14a2a;
  background: rgba(240, 138, 104, 0.16);
  border-color: rgba(240, 138, 104, 0.4);
}

.anonQuotaChipLow a {
  color: #b14a2a;
}

.aiDisclaimer {
  text-align: center;
  font-size: 11px;
  color: var(--ink-500);
  margin: 0;
  padding-bottom: 4px;
  line-height: 1.5;
}

.primaryButton {
  background: var(--teal-500);
  color: #ffffff;
  border: none;
  padding: 10px 16px;
  border-radius: 12px;
  font-size: 13px;
  cursor: pointer;
  box-shadow: 0 12px 24px rgba(15, 143, 141, 0.2);
  transition: transform 0.2s ease, background 0.2s ease;
}

.primaryButton:hover:not(:disabled) {
  background: var(--teal-700);
  transform: translateY(-1px);
}

.primaryButton:disabled,
.suggestionChip:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.secondaryButton {
  background: var(--ink-900);
  color: #ffffff;
  border: none;
  padding: 10px 16px;
  border-radius: 12px;
  font-size: 13px;
  cursor: pointer;
}

.ghostButton {
  background: transparent;
  border: 1px solid var(--sand-200);
  color: var(--ink-900);
  padding: 10px 16px;
  border-radius: 12px;
  font-size: 13px;
  cursor: pointer;
}

@media (max-width: 1100px) {
  .page {
    grid-template-columns: 1fr;
    grid-template-rows: minmax(0, 1fr);
  }

  .sidebarBackdrop {
    display: block;
    position: fixed;
    inset: 0;
    background: rgba(15, 34, 52, 0.4);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    z-index: 998;
  }

  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 300px;
    z-index: 999;
    background: #ffffff;
    border-right: 1px solid var(--sand-200);
    border-bottom: none;
    transform: translateX(-100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 24px 20px;
  }

  .sidebarOpen {
    transform: translateX(0);
  }

  .mobileSidebarToggle {
    display: inline-block;
  }

  .mobileSidebarToggleMain {
    display: flex;
    align-items: center;
  }

  .sidebarContent {
    display: flex;
  }

  .sidebarContentOpen {
    display: flex;
  }
}

@media (max-width: 760px) {
  .header {
    flex-direction: row;
    align-items: center;
  }

  /* Input bar stays horizontal on mobile — send button sits inline */
  .inputBar {
    flex-direction: row;
    align-items: flex-end;
    padding: 8px 10px;
    gap: 8px;
    border-radius: 14px;
  }

  .headerActions {
    display: none;
  }

  /* The bottom tab bar handles primary navigation on mobile, so the
     same links inside the chat sidebar are redundant. Hide them so the
     sidebar focuses on what's unique here: chat history and account actions. */
  .sidebarNavLinks {
    display: none;
  }

  .messageBubble {
    max-width: 90%;
  }

  /* Hide decorative metadata row — frees a full row for chat content */
  .contextBar {
    display: none;
  }

  .suggestionGrid {
    flex-wrap: nowrap;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .suggestionGrid::-webkit-scrollbar {
    display: none;
  }

  .suggestionChip {
    flex-shrink: 0;
  }
}

@media (max-width: 640px) {
  .sidebar {
    padding: 16px 5vw;
  }

  .main {
    /* Reserve 64px + safe-area bottom for the global mobile tab bar */
    padding: 10px 4vw calc(16px + 64px + env(safe-area-inset-bottom));
    gap: 6px;
  }

  /* Compact header on mobile — full title is too long for one line */
  .header {
    margin-bottom: 0;
  }

  .header h1 {
    font-size: 1.15rem;
    margin-top: 0;
    line-height: 1.2;
  }

  /* Hide the visible label text on mobile — the placeholder serves as context */
  .inputLabelText {
    display: none;
  }

  /* Hide quota chip on mobile — sidebar already shows remaining count */
  .anonQuotaChip {
    display: none;
  }

  /* Single-row compact textarea */
  .inputLabel textarea {
    padding: 8px 10px;
    font-size: 13px;
    border-radius: 10px;
    min-height: 38px;
    max-height: 120px;
  }

  .inputLabel {
    gap: 0;
  }

  .inputActions {
    flex-shrink: 0;
  }

  .primaryButton {
    padding: 8px 14px;
    font-size: 12px;
    border-radius: 10px;
    white-space: nowrap;
  }

  .suggestions {
    gap: 6px;
  }

  .suggestionLabel {
    font-size: 11px;
  }

  .suggestionChip {
    padding: 6px 10px;
    font-size: 11px;
  }

  .aiDisclaimer {
    font-size: 10px;
    padding-bottom: 2px;
  }

  .titleFull {
    display: none;
  }

  .titleShort {
    display: inline;
  }
}
